{
  "expo": {
    "name": "RHAQ ASHA App",
    "slug": "rhaq-asha-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F6E56"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "dev.rhaq.ashaapp",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.rhaq.ashaapp"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
